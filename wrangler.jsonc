{
  "name": "sbchild-top",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2026-10-09",
  "compatibility_flags": ["nodejs_als"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare"
  },
  "routes": [{ "pattern": "sbchild.top", "custom_domain": true }]
}
